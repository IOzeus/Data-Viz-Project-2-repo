{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": {"step": 20},
  "data": {"url": "data/share-price-index.csv", "format": {"type": "csv", "parse": {"Index": "number"}}},
  "transform": [
    {"filter": "substring(datum.Month, 5, 7) == '12'"},
    {"calculate": "toNumber(substring(datum.Month, 0, 4))", "as": "Year"},
    {
      "window": [{"op": "lag", "field": "Index", "as": "Prev"}, {"op": "lag", "field": "Year", "as": "PrevYear"}],
      "groupby": ["Code"],
      "sort": [{"field": "Year"}]
    },
    {"filter": "datum.Year >= 1997 && datum.Year <= 2016 && datum.PrevYear == datum.Year - 1"},
    {"calculate": "(datum.Index / datum.Prev - 1) * 100", "as": "Return"},
    {
      "aggregate": [
        {"op": "min", "field": "Return", "as": "Worst"},
        {"op": "q1", "field": "Return", "as": "Q1"},
        {"op": "median", "field": "Return", "as": "Median"},
        {"op": "q3", "field": "Return", "as": "Q3"},
        {"op": "max", "field": "Return", "as": "Best"}
      ],
      "groupby": ["Code"]
    },
    {
      "lookup": "Code",
      "from": {"data": {"url": "data/countries.csv"}, "key": "Code", "fields": ["Name"]}
    },
    {"calculate": "format(datum.Median, '+.0f') + '%'", "as": "MedianLabel"},
    {"calculate": "format(datum.Worst, '+.0f') + '% to ' + format(datum.Best, '+.0f') + '%'", "as": "RangeLabel"}
  ],
  "encoding": {
    "y": {
      "field": "Name",
      "type": "nominal",
      "sort": {"field": "Median", "op": "min", "order": "descending"},
      "axis": {
        "title": null,
        "ticks": false,
        "domain": false,
        "labelFontWeight": {"expr": "datum.label == 'Australia' ? 700 : 400"},
        "labelColor": {"expr": "datum.label == 'Australia' ? '#b8430a' : '#555555'"}
      }
    },
    "tooltip": [
      {"field": "Name", "title": "Market"},
      {"field": "MedianLabel", "title": "Typical year"},
      {"field": "RangeLabel", "title": "Worst to best year"}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rule", "color": "#b5b5b5"},
      "encoding": {
        "x": {
          "field": "Worst",
          "type": "quantitative",
          "scale": {"domain": [-60, 100], "clamp": true},
          "axis": {"title": "Yearly change in share price index", "orient": "top", "labelExpr": "(datum.value > 0 ? '+' : '') + datum.value + '%'", "gridColor": "#f0f0f0", "domain": false}
        },
        "x2": {"field": "Best"}
      }
    },
    {
      "mark": {"type": "bar", "height": 12},
      "encoding": {
        "x": {"field": "Q1", "type": "quantitative"},
        "x2": {"field": "Q3"},
        "color": {"condition": {"test": "datum.Code == 'AUS'", "value": "#e8590c"}, "value": "#9fb8d4"}
      }
    },
    {
      "mark": {"type": "tick", "color": "#ffffff", "thickness": 2, "size": 12},
      "encoding": {"x": {"field": "Median", "type": "quantitative"}}
    },
    {
      "data": {"values": [{"x": 0}]},
      "mark": {"type": "rule", "color": "#999999", "strokeDash": [3, 3]},
      "encoding": {"x": {"field": "x", "type": "quantitative"}, "y": null, "tooltip": null}
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Inter",
    "axis": {"labelFontSize": 11, "titleFontSize": 11, "labelColor": "#666", "titleColor": "#666"}
  }
}
